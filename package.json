{
  "name": "arcade-o-rade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/studio.mjs catalog && npm run dev --workspace=@arcade-o-rade/arcade",
    "new:game": "node scripts/studio.mjs new",
    "validate": "node scripts/studio.mjs validate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.mjs",
    "build": "node scripts/studio.mjs build",
    "preview": "vite preview --outDir dist --base /arcade-o-rade/ --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "check": "npm run validate && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
